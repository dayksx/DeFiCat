# DeFiCat gitignore policy
# Commit templates (.env.example). Never commit secrets, deps, or build output.

# --- Secrets & env ---
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
credentials.json
service-account*.json

# --- Dependencies ---
node_modules/
.pnpm-store/
.pnp
.pnp.js

# --- Build / Next / Nest ---
dist/
dist-worker/
build/
out/
.next/
.nuxt/
.turbo/
*.tsbuildinfo

# --- Tests & coverage ---
coverage/
.nyc_output/
.vitest/

# --- Logs & runtime ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Caches & temp ---
.cache/
.temp/
.tmp/
*.local

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors ---
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Deploy ---
.vercel/
.mau/

# Clients
TELEGRAM_BOT_TOKEN=

# LLM — LiteLLM (OpenAI-compatible gateway)
# baseURL is the proxy origin + /v1 (dashboard / docs of your LiteLLM instance)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://your-litellm-host/v1
LITELLM_MODEL=claude-haiku-4.5

# Alternative if listed in your LiteLLM dashboard: claude-sonnet-4-6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINTAI_API_KEY=

# Agentic Framework
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
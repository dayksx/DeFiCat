# Clients
TELEGRAM_BOT_TOKEN=
# Telegraf drops an update that runs longer than this. An ENS buy needs ~2 min
# (commit, 60s commitment age, register), well past Telegraf's 90s default.
TELEGRAM_HANDLER_TIMEOUT_MS=900000

# Origine de la UI (CORS + URI SIWE). Port 3001, le bot reste sur 3000.
UI_ORIGIN=http://localhost:3001

# EIP-4361 « domain » = host[:port], SANS schéma.
SIWE_DOMAIN=localhost:3001

# Unique chain for SIWE + ENS (quotes, buys, subgraph).
# 1 = Ethereum mainnet. ETHEREUM_RPC_URL must point at this chain.
# 11155111 = Sepolia works for lookups and quotes only: ENS revoked its v1
# registrar controllers there, so `register` reverts after the commit.
CHAIN_ID=1

SIWE_STATEMENT=Sign in to DeFiCat and link this wallet to your Telegram chat.

# LLM
LITELLM_API_KEY= # LLM — LiteLLM (OpenAI-compatible gateway)
LITELLM_BASE_URL=https://your-litellm-host/v1 # baseURL is the proxy origin + /v1 (dashboard / docs of your LiteLLM instance)
LITELLM_MODEL=claude-haiku-4.5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINTAI_API_KEY=

# Tools
TAVILY_API_KEY=
THEGRAPH_API_KEY= # https://thegraph.com/studio/apikeys/

# ENS purchase — agent EOA on CHAIN_ID. Dedicated low-balance key only.
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/...
# Optional overrides if a preset address is wrong after an ENS redeploy.
# ENS_REGISTRAR_CONTROLLER=
# ENS_PUBLIC_RESOLVER=
# ENS_SUBGRAPH_ID=
AGENT_PRIVATE_KEY=0x...
# Hard ceiling for one registration, including 5% price slippage.
ENS_MAX_PURCHASE_ETH=0.02
# Comma-separated Telegram chat IDs allowed to spend the EOA funds.
ENS_BUYER_ALLOWED_TELEGRAM_CHAT_IDS=123456789

# IANA time zone the agent reports dates in. Defaults to the host time zone.
AGENT_TIMEZONE=Europe/Paris

# Durable scheduling. `memory` records watches and buys nothing, and loses them
# on restart; `temporal` is the real thing and requires a reachable server.
ENS_WATCH_SCHEDULER=memory

# Temporal. Read by both the bot and the worker process, which must agree on
# namespace and task queue to find each other.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ens-drop
# Temporal Cloud only.
# TEMPORAL_TLS=true
# TEMPORAL_API_KEY=

# Agentic Framework
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=